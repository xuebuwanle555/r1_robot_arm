+
+std::array<ArmMotorBus::FeedbackStats, kArmJointCount> ArmMotorBus::feedbackStats() const {
+    // PATCHED: report per-joint reception time/counter instead of a sticky flag.
+    std::lock_guard<std::mutex> lock(impl_->fb_mutex);
+    std::array<FeedbackStats, kArmJointCount> out{};
+    const uint64_t now = steadyNowNs();
+    for (int i = 0; i < kArmJointCount; ++i) {
+        out[i].packets = impl_->rx_count[i];
+        out[i].received = impl_->rx_count[i] > 0;
+        out[i].age_ns = (out[i].received && now >= impl_->last_rx_ns[i])
+                            ? (now - impl_->last_rx_ns[i])
+                            : 0;
+    }
+    return out;
+}
