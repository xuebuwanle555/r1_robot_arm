+std::array<ArmMotorBus::FeedbackStats, kArmJointCount> ArmMotorBus::feedbackStats() const {
+    // PATCHED: report per-joint reception time/counter instead of a sticky flag.
+    std::lock_guard<std::mutex> lock(impl_->fb_mutex);
+    std::array<FeedbackStats, kArmJointCount> out{};
+    const uint64_t now = steadyNowNs();
+    for (int i = 0; i < kArmJointCount; ++i) {
+        out[i].packets = impl_->rx_count[i];
+        out[i].received = impl_->rx_count[i] > 0;
+        out[i].age_ns = (out[i].received && now >= impl_->last_rx_ns[i])
+                            ? (now - impl_->last_rx_ns[i])
+                            : 0;
+        out[i].now_ns = now;
+    }
+    return out;
+}
+
+ArmMotorBus::FeedbackSnapshot ArmMotorBus::feedbackSnapshot() const {
+    // PATCHED: values and reception evidence under ONE lock, ages measured
+    // against a SINGLE captured `now`.  This is what makes the snapshot atomic:
+    // a stale value can never be paired with a fresh timestamp.
+    std::lock_guard<std::mutex> lock(impl_->fb_mutex);
+    FeedbackSnapshot snap;
+    const uint64_t now = steadyNowNs();
+    for (int i = 0; i < kArmJointCount; ++i) {
+        const auto& m = impl_->latest_motor[i];
+        const auto& cal = impl_->calib[i];
+        snap.states[i].q = motorToUrdfAngle(m.q, cal);
+        snap.states[i].dq = motorToUrdfVec(m.dq, cal);
+        snap.states[i].tau_est = motorToUrdfVec(m.tau_est, cal);
+        snap.states[i].mode = m.mode;
+        snap.states[i].timeout = m.timeout;
+        snap.states[i].error_code = m.error_code;
+        snap.stats[i].packets = impl_->rx_count[i];
+        snap.stats[i].received = impl_->rx_count[i] > 0;
+        snap.stats[i].age_ns = (snap.stats[i].received && now >= impl_->last_rx_ns[i])
+                                   ? (now - impl_->last_rx_ns[i])
+                                   : 0;
+        snap.stats[i].now_ns = now;
+    }
+    return snap;
+}
