+    struct FeedbackStats {
+        uint64_t packets = 0;   //!< valid (CRC-checked) packets received
+        bool received = false;  //!< packets > 0
+        uint64_t age_ns = 0;    //!< time since the last valid packet (0 if none)
+    };
+    std::array<FeedbackStats, kArmJointCount> feedbackStats() const;
